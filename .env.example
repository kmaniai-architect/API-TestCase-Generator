# Copy this file to .env, fill in the key(s) you have, then restart: npm start
# Only providers with a key are enabled in the AI dropdown. Models below are defaults — change freely.

# Which provider is pre-selected: gemini | anthropic | openai | groq | mistral | deepseek | openrouter | ollama
LLM_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Groq
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Mistral
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest

# DeepSeek
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# OpenRouter (one key, many models)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Ollama (local, no key) — uncomment to enable
# OLLAMA_MODEL=llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Saved suites database (default: testcase.db in this folder)
# DB_FILE=testcase.db

# PORT=3000
